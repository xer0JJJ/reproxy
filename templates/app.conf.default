# =====================================================================
# Reverse Proxy Template v1.0 by xer0
# Template de configuração da aplicação
#
# Este arquivo é utilizado pelo prepare.sh para gerar:
# nginx/conf.d/app.conf
#
# Caso deseje alterações permanentes, edite este arquivo.
# =====================================================================

server {

    listen 80;
    server_name exemplo.com.br;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # AUTO_REDIRECT_SSL
    # return 301 https://$host$request_uri;

    location / {

        proxy_pass http://host.docker.internal:8080;

        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";

        proxy_read_timeout 300;
        proxy_send_timeout 300;

    }

}

